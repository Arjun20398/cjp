3. JavaScript (js/app.js)
js
Copy
// 1. Hide splash screen after 3s
setTimeout(() => {
  document.getElementById('splash').style.display = 'none';
}, 3000);

// 2. Animated Counters (example: increment SR count to 100)
let srCount = 0;
const srElem = document.getElementById('srCount');
const srInterval = setInterval(() => {
  srCount += Math.floor(Math.random()*5) + 1;
  srElem.textContent = srCount;
  if (srCount > 3000) clearInterval(srInterval);  // stop somewhere
}, 1000);

// 3. Scroll reveal (IntersectionObserver)
const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.1 });
reveals.forEach(r => observer.observe(r));

// 4. Bingo Game Logic
const squares = document.querySelectorAll('.bingo-square');
squares.forEach(sq => {
  sq.addEventListener('click', () => {
    sq.classList.toggle('active');
    // Save state to localStorage
    const index = sq.dataset.index;
    const marked = sq.classList.contains('active');
    let board = JSON.parse(localStorage.getItem('bingoBoard')) || {};
    board[index] = marked;
    localStorage.setItem('bingoBoard', JSON.stringify(board));
  });
});
// On load, restore bingo state
let savedBoard = JSON.parse(localStorage.getItem('bingoBoard')) || {};
squares.forEach(sq => {
  if (savedBoard[sq.dataset.index]) sq.classList.add('active');
});

// 5. Load Wall of Shame stories (static array example)
const stories = [
  `"My complaint was marked resolved while on call explaining it." – Ankit P.`,
  `"Transferred 6 times in one call. Now I know Airtel's IVR by heart." – Priya S.`,
  // ... more stories
];
const wallContainer = document.getElementById('wall-content');
let storyIndex = 0;
document.getElementById('load-more').addEventListener('click', () => {
  if (storyIndex < stories.length) {
    const p = document.createElement('p');
    p.textContent = stories[storyIndex++];
    wallContainer.appendChild(p);
  } else {
    wallContainer.appendChild(document.createElement('p')).textContent = "No more stories.";
    document.getElementById('load-more').disabled = true;
  }
});
// Trigger initial load
document.getElementById('load-more').click();

// 6. Interactive FAQ toggle (optional)
document.querySelectorAll('.faq-item h3').forEach(q => {
  q.addEventListener('click', () => {
    q.nextElementSibling.classList.toggle('visible');
  });
});
The above JS handles splash timeout, counter increments, scroll reveals, Bingo click events with localStorage, loading “Wall of Shame” stories from a JS array, and toggling FAQ answers.
All code is vanilla JS (no imports). For production, you would minify this file.
